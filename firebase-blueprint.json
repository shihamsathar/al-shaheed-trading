{
  "entities": {
    "User": {
      "title": "User",
      "description": "Trading platform partner or admin profile including credentials and business specifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "SUPPLIER", "BUYER", "AGENT"] },
        "companyName": { "type": "string" },
        "phone": { "type": "string" },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "businessRegNumber": { "type": "string" },
        "taxVatNumber": { "type": "string" },
        "website": { "type": "string" },
        "typicalVolume": { "type": "string" },
        "tradingRegion": { "type": "string" },
        "languages": { "type": "string" },
        "experienceYears": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "PENDING", "SUSPENDED", "DEACTIVATED"] },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["id", "email", "name", "role", "status"]
    },
    "ScrapListing": {
      "title": "ScrapListing",
      "description": "Industrial scrap metal or recyclable commodity inventory lot offered by suppliers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplierId": { "type": "string" },
        "commodityCategory": { "type": "string" },
        "materialName": { "type": "string" },
        "scrapType": { "type": "string" },
        "grade": { "type": "string" },
        "description": { "type": "string" },
        "quantity": { "type": "number" },
        "quantityUnit": { "type": "string" },
        "pricePerUnit": { "type": "number" },
        "currency": { "type": "string" },
        "countryOfOrigin": { "type": "string" },
        "portOfShipping": { "type": "string" },
        "incoterms": { "type": "string" },
        "paymentTerms": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "AVAILABLE", "RESERVED", "SOLD", "INSPECTING", "ARCHIVED"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "supplierId", "commodityCategory", "materialName", "quantity", "pricePerUnit", "status"]
    },
    "BuyerRequirement": {
      "title": "BuyerRequirement",
      "description": "Demand inquiry and purchase requisition submitted by scrap consumers and smelting mills",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "buyerId": { "type": "string" },
        "commodityCategory": { "type": "string" },
        "materialName": { "type": "string" },
        "grade": { "type": "string" },
        "requiredQuantity": { "type": "number" },
        "quantityUnit": { "type": "string" },
        "targetPricePerUnit": { "type": "number" },
        "currency": { "type": "string" },
        "destinationCountry": { "type": "string" },
        "destinationPort": { "type": "string" },
        "incoterms": { "type": "string" },
        "paymentTerms": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "MATCHED", "FULFILLED", "EXPIRED", "CANCELLED"] },
        "urgency": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "buyerId", "commodityCategory", "materialName", "requiredQuantity", "status"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Back-to-back purchase & sale contract trade order managed by Al Shaheed platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dealNumber": { "type": "string" },
        "listingId": { "type": "string" },
        "supplierId": { "type": "string" },
        "buyerId": { "type": "string" },
        "materialName": { "type": "string" },
        "grade": { "type": "string" },
        "quantityMT": { "type": "number" },
        "unitPrice": { "type": "number" },
        "totalPrice": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "incoterms": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "dealNumber", "materialName", "quantityMT", "status"]
    },
    "AgentAssignment": {
      "title": "AgentAssignment",
      "description": "Scrap lot assigned by Admin to intermediary sales agent with commission rates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "listingId": { "type": "string" },
        "agentId": { "type": "string" },
        "quantityMT": { "type": "number" },
        "targetSalesPrice": { "type": "number" },
        "agentRatePerTon": { "type": "number" },
        "calculatedAgentAmount": { "type": "number" },
        "status": { "type": "string" },
        "assignedAt": { "type": "string" }
      },
      "required": ["id", "listingId", "agentId", "status"]
    },
    "TradeDocument": {
      "title": "TradeDocument",
      "description": "Official trade and customs compliance document such as BL, LC, SGS Inspection, Commercial Invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "documentNumber": { "type": "string" },
        "title": { "type": "string" },
        "fileName": { "type": "string" },
        "status": { "type": "string" },
        "issuedDate": { "type": "string" }
      },
      "required": ["id", "type", "title", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System alert or workflow message for users and administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientId": { "type": "string" },
        "recipientRole": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "message", "isRead", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Security and compliance audit trail of critical events and transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "action": { "type": "string" },
        "entity": { "type": "string" },
        "entityId": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "action", "entity", "timestamp"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Platform global configuration and default commercial parameters",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "defaultCurrency": { "type": "string" },
        "defaultCommissionRatePerMT": { "type": "number" },
        "platformFeePercentage": { "type": "number" }
      },
      "required": ["companyName", "defaultCurrency"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Registered trading counterparties, agents, and administrators"
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/ScrapListing" },
      "description": "Scrap material inventory listings"
    },
    "/requirements/{requirementId}": {
      "schema": { "$ref": "#/entities/BuyerRequirement" },
      "description": "Buyer demand inquiries and procurement requests"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "B2B trading transactions and contract orders"
    },
    "/agentAssignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/AgentAssignment" },
      "description": "Material sales assignments for trade agents"
    },
    "/tradeDocuments/{documentId}": {
      "schema": { "$ref": "#/entities/TradeDocument" },
      "description": "Shipping, commercial, and quality compliance documents"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications and alerts"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit trail entries"
    },
    "/systemSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "Platform operational settings"
    }
  }
}
